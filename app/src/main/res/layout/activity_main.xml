<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F7FA">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proyecto Final"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#00796B"
            android:layout_marginBottom="24dp" />

        <!-- Nombres fijos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Andrea Carrera"
            android:textColor="#004D40"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Luis Montenegro"
            android:textColor="#004D40"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Adriana Solanilla"
            android:textColor="#004D40"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="• Kidian Jorge"
            android:textColor="#004D40"
            android:textSize="18sp" />

        <!-- Botones -->
        <Button
            android:id="@+id/btnPantalla1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ir a Pantalla 1"
            android:backgroundTint="#26A69A"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnPantalla2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ir a Pantalla 2"
            android:layout_marginTop="16dp"
            android:backgroundTint="#26A69A"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnPantalla3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ir a Pantalla 3"
            android:layout_marginTop="16dp"
            android:backgroundTint="#26A69A"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>