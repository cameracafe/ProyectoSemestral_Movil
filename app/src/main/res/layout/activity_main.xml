<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_degradado">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Título principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proyecto Final"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Lista de nombres -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Andrea Carrera"
            android:textColor="#E1F5FE"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Luis Montenegro"
            android:textColor="#E1F5FE"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Adriana Solanilla"
            android:textColor="#E1F5FE"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Kidian Jorge"
            android:textColor="#E1F5FE"
            android:textSize="18sp"
            android:layout_marginBottom="28dp" />

        <!-- Subtítulo de menú -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menú"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- Botón Sensor de Luz -->
        <Button
            android:id="@+id/btnPantalla1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor de Luz"
            android:background="@drawable/btn_estilo"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <!-- Botón Sensor PickUp -->
        <Button
            android:id="@+id/btnPantalla2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor PickUp"
            android:background="@drawable/btn_estilo"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <!-- Botón Pare para niños -->
        <Button
            android:id="@+id/btnPantalla3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pare para niños"
            android:background="@drawable/btn_estilo"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>